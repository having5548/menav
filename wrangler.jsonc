{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "menav",
  "compatibility_date": "2026-09-01",
  // 纯静态站点（astro output: 'static'）：不需要 @astrojs/cloudflare 适配器，
  // 直接把 dist/ 作为 Workers 静态资源上传即可。
  // 注意必须有这份配置文件：否则 `wrangler deploy` 会触发 autoconfig，
  // 检测到 Astro 后去执行 `astro add cloudflare`，从而安装失败、整个部署报错。
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
